{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lvcn-registro-experimento/1",
  "title": "Registro reproducible de un experimento del Laboratorio Virtual de Ciencias Naturales",
  "description": "Generado por src/lib/experimentRecord.ts (buildExperimentRecord). Sin datos personales. Ver ADR 0003.",
  "type": "object",
  "required": ["formato", "id", "fecha", "software", "practica", "pregunta", "modelo", "procedencia", "medicion", "conjuntos", "advertencias", "estado"],
  "properties": {
    "formato": { "const": "lvcn-registro-experimento/1" },
    "id": { "type": "string", "description": "Identificador del registro: <práctica>-<marca de tiempo en base 36>" },
    "fecha": { "type": "string", "format": "date-time" },
    "software": {
      "type": "object", "required": ["nombre", "version"],
      "properties": { "nombre": { "type": "string" }, "version": { "type": "string", "description": "Versión semántica de la aplicación (CHANGELOG.md)" } }
    },
    "practica": {
      "type": "object", "required": ["id", "titulo", "grado", "area"],
      "properties": { "id": { "type": "string" }, "titulo": { "type": "string" }, "grado": { "type": "integer", "minimum": 6, "maximum": 11 }, "area": { "type": "string" } }
    },
    "pregunta": { "type": "string", "description": "Pregunta problema de la práctica" },
    "hipotesis": { "type": "object", "deprecated": true, "description": "Obsoleto y opcional (ADR 0006): solo aparece en registros generados antes de retirar la etapa de hipótesis; al importar se ignora.", "properties": { "texto": { "type": "string" }, "tendencia": { "type": "string" } } },
    "modelo": {
      "type": "object", "required": ["nombre", "ecuaciones", "supuestos", "limites", "referencias"],
      "properties": {
        "nombre": { "type": "string" },
        "ecuaciones": { "type": "array", "items": { "type": "string" } },
        "supuestos": { "type": "array", "items": { "type": "string" } },
        "limites": { "type": "array", "items": { "type": "string" } },
        "referencias": { "type": "array", "items": { "type": "string" } }
      }
    },
    "procedencia": {
      "type": "object", "required": ["datos", "escena", "detalle"],
      "properties": {
        "datos": { "enum": ["Evidencia experimental", "Predicción computacional", "Modelo calculado", "Ilustración educativa", "Sin información disponible"] },
        "escena": { "enum": ["Evidencia experimental", "Predicción computacional", "Modelo calculado", "Ilustración educativa", "Sin información disponible"] },
        "detalle": { "type": "string" }
      }
    },
    "medicion": {
      "type": "object", "required": ["modo", "semilla", "lecturas"],
      "properties": {
        "modo": { "enum": ["ideal", "real"] },
        "semilla": { "type": "string", "description": "Regla de la semilla: determinista a partir de (práctica, clave de la lectura, número de lectura)" },
        "lecturas": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "description": "Número de lecturas hechas por clave" }
      }
    },
    "conjuntos": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "nombre", "columnas", "ensayos"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "columnas": {
            "type": "array",
            "items": {
              "type": "object", "required": ["clave", "nombre", "entrada"],
              "properties": { "clave": { "type": "string" }, "nombre": { "type": "string" }, "unidad": { "type": "string" }, "entrada": { "type": "boolean" }, "resolucion": { "type": "number" } }
            }
          },
          "ensayos": {
            "type": "array",
            "items": {
              "type": "object", "required": ["id", "fecha", "valores", "estatus"],
              "properties": {
                "id": { "type": "string" },
                "fecha": { "type": "string", "format": "date-time" },
                "valores": { "type": "object", "additionalProperties": { "type": ["number", "string", "null"] } },
                "nota": { "type": "string" },
                "estatus": { "type": "string" },
                "version": { "type": "string" },
                "medicion": { "enum": ["ideal", "real"] }
              }
            }
          }
        }
      }
    },
    "advertencias": { "type": "array", "items": { "type": "string" } },
    "estado": { "enum": ["con-datos", "sin-datos"] }
  },
  "additionalProperties": false
}
