{
  "name": "laboratorio-virtual-ciencias-naturales",
  "private": true,
  "version": "1.3.0",
  "description": "Laboratorio Virtual de Ciencias Naturales: prácticas interactivas para grados 6.º a 11.º (Colombia).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "build:single": "tsc -b && vite build --mode single && node scripts/inline-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "server": "node server/index.mjs",
    "guias": "node scripts/guias/exportar.mjs && python3 scripts/guias/generar_guias.py"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.6",
    "@fontsource/bricolage-grotesque": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.6",
    "3dmol": "2.5.5",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
